<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAFAF7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/textDetailRecipeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2E5B45"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/textDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe description"
            android:textSize="15sp"
            android:textColor="#555555"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:id="@+id/textDetailTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preparation time: 10 minutes"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#2E5B45"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredients"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#2E5B45"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/textDetailIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredients will appear here"
            android:textSize="16sp"
            android:textColor="#333333"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cooking Instructions"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#2E5B45"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/textDetailInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cooking instructions will appear here"
            android:textSize="16sp"
            android:textColor="#333333"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="28dp"/>

        <Button
            android:id="@+id/btnBackToRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Recipes"
            android:textAllCaps="false"/>

    </LinearLayout>

</ScrollView>
