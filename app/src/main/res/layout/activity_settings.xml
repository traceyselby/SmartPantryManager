<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAF7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2E5B45"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage your pantry and view app information."
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pantry Statistics"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#2E5B45"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/textTotalIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total pantry ingredients: 0"
            android:textSize="16sp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/textTotalRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipes in database: 0"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pantry Management"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#2E5B45"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnClearPantry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear All Pantry Ingredients"
            android:textAllCaps="false"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About Smart Pantry Manager"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#2E5B45"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Pantry Manager helps reduce food waste by suggesting recipes that can be prepared using ingredients already available in your pantry."
            android:textSize="15sp"
            android:textColor="#555555"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Version 1.0"
            android:textSize="13sp"
            android:textColor="#777777"
            android:layout_marginBottom="28dp"/>

        <Button
            android:id="@+id/btnBackFromSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Pantry"
            android:textAllCaps="false"/>

    </LinearLayout>

</ScrollView>
